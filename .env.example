# Copy this file to .env and fill in your own keys.
# Never commit the real .env file or share your keys with anyone.

# Azure OpenAI (leave these empty to run with the built-in mock AI for testing)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Tavily (used for competitor search in the outline step)
TAVILY_API_KEY=

# App settings
APP_NAME="AI Content Writing Tool"
ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
